---
import Layout from '../layouts/Layout.astro';
import EventCountdown from '../components/EventCountdown.astro';
import GitHubActivity from '../components/GitHubActivity.astro';
import Icon from '../components/Icon.astro';
import Languages from '../components/Languages.astro';
import VisitorCounter from '../components/VisitorCounter.astro';

// start は日本時間(+09:00)で書く。label は start が何の時刻か (開演・開場など)
const events = [
    { name: '米津玄師 2026 TOUR / GHOST', start: '2026-11-11T18:30:00+09:00', label: '開演' },
    { name: '配信者ハイパーゲーム大会 FINAL', start: '2026-11-29T11:00:00+09:00', label: '開場' },
];

// Currently Working On。GitHub のピン留めリポジトリ風に並べる (name はカードの見出し、color は丸の色)
const goals = [
    { name: 'fe-exam', title: '基本情報技術者試験', color: '#3fb950' },
    { name: 'toeic-800', title: 'TOEIC800↑', color: '#d29922' },
    { name: 'learn-programming', title: 'プログラミング言語学習', color: '#4493f8' },
];

// 扱える・勉強中のプログラミング言語。新しく始めたら1行足し、扱えるようになったら status を '扱える' に変える
// 色の丸と拡張子は名前から自動で付く (付かない言語は color: '#rrggbb' と ext: '.xxx' を書き足す)
const languages = [
    { name: 'C#', status: '勉強中' },
    { name: 'C++', status: '勉強中' },
];

const badges = [
    { key: 'built with', value: 'Astro', color: '#bc52ee' },
    { key: 'hosted on', value: 'Vercel', color: '#000000' },
    { key: 'studying', value: '基本情報', color: '#2f81f7' },
    { key: 'TOEIC', value: '→ 800', color: '#bb8009' },
];
---

<Layout title="ペン様のホームページ">
    <section class="box">
        <div class="box-header"><Icon name="book" /> pensama / README.md</div>
        <div class="box-body readme">
            <h2>Hi there 👋 ペン様です</h2>
            <p>電気通信大学に通う大学1年生。ゲームと漫画と米津玄師が好き。</p>
            <p class="badges">
                {badges.map((badge) => (
                    <span class="badge">
                        <span>{badge.key}</span>
                        <span style={`background-color: ${badge.color}`}>{badge.value}</span>
                    </span>
                ))}
            </p>
            <div class="visitors">
                <VisitorCounter />
            </div>
        </div>
    </section>

    <section>
        <h2 class="section-title"><Icon name="pin" /> Currently Working On</h2>
        <ul class="pinned">
            {goals.map((goal) => (
                <li class="pin box">
                    <div class="pin-head">
                        <Icon name="repo" />
                        <span class="pin-name">{goal.name}</span>
                        <span class="label">Goal</span>
                    </div>
                    <p class="pin-desc">{goal.title}</p>
                    <p class="pin-meta"><span class="dot" style={`--c: ${goal.color}`}></span>勉強中</p>
                </li>
            ))}
            <li class="pin box">
                <div class="pin-head">
                    <Icon name="repo" />
                    <a class="pin-name" href="https://github.com/pensama/my-homepage" target="_blank" rel="noopener noreferrer">my-homepage</a>
                    <span class="label">Public</span>
                </div>
                <p class="pin-desc">このホームページ — 随時更新予定</p>
                <p class="pin-meta"><span class="dot" style="--c: #ff5a03"></span>Astro</p>
            </li>
        </ul>
    </section>

    <section>
        <h2 class="section-title"><Icon name="code" /> Languages</h2>
        <Languages languages={languages} />
    </section>

    <section>
        <h2 class="section-title"><Icon name="clock" /> 参加予定のイベント</h2>
        <EventCountdown events={events} />
    </section>

    <section>
        <GitHubActivity user="pensama" />
    </section>
</Layout>

<style>
    .readme h2 {
        margin: 0 0 16px;
        padding-bottom: 8px;
        border-bottom: 1px solid var(--border);
        font-size: 24px;
        line-height: 1.25;
    }

    .readme p {
        margin: 0;
    }

    .readme .badges {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        margin-top: 16px;
    }

    .badge {
        display: inline-flex;
        border-radius: 3px;
        overflow: hidden;
        font-family: var(--font-mono);
        font-size: 11px;
        line-height: 20px;
        color: #fff;
    }

    .badge span {
        padding: 0 6px;
    }

    .badge span:first-child {
        background-color: #555;
    }

    .visitors {
        margin-top: 16px;
        padding-top: 16px;
        border-top: 1px solid var(--border);
    }

    .pinned {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 16px;
    }

    .pin {
        display: flex;
        flex-direction: column;
        padding: 16px;
    }

    .pin-head {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .pin-head :global(.icon) {
        color: var(--fg-muted);
    }

    .pin-name {
        flex: 1;
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        font-weight: 700;
        font-size: 14px;
        color: var(--accent);
    }

    .pin-desc {
        flex: 1;
        margin: 8px 0 16px;
        font-size: 13px;
        color: var(--fg-muted);
    }

    .pin-meta {
        display: flex;
        align-items: center;
        gap: 6px;
        margin: 0;
        font-size: 12px;
        color: var(--fg-muted);
    }

    @media (max-width: 767px) {
        .pinned {
            grid-template-columns: minmax(0, 1fr);
        }
    }
</style>
