---
import Icon from '../components/Icon.astro';
import ProfileSidebar from '../components/ProfileSidebar.astro';

interface Props {
    title: string;
}

const { title } = Astro.props;

const tabs = [
    { href: '/', label: 'Overview', icon: 'book' },
    { href: '/about', label: 'About', icon: 'person' },
    { href: '/works', label: 'Works', icon: 'repo' },
] as const;

// 末尾の / を取って比べる (/about/ と /about を同じページとして扱う)
const current = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<html lang="ja">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{title}</title>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=M+PLUS+1+Code:wght@400;700&family=Zen+Kaku+Gothic+New:wght@400;700&display=swap"
            rel="stylesheet"
        />
    </head>
    <body>
        <header class="site-header">
            <div class="topbar">
                <a class="brand" href="/">
                    <img src="/images/Icon.jpg" alt="" width="32" height="32" />
                    pensama
                </a>
            </div>
            <nav class="tabs" aria-label="ページ">
                {tabs.map((tab) => (
                    <a href={tab.href} aria-current={current === tab.href ? 'page' : undefined}>
                        <Icon name={tab.icon} />
                        {tab.label}
                    </a>
                ))}
            </nav>
        </header>

        <div class="container">
            <ProfileSidebar />
            <main>
                <slot />
            </main>
        </div>

        <footer>
            <Icon name="mark-github" size={20} />
            © 2026 pensama
        </footer>
    </body>
</html>

<style is:global>
    /* デジタル時計風の7セグメント数字 (DSEG, SIL Open Font License 1.1) */
    @font-face {
        font-family: "DSEG7 Classic";
        src: url("/fonts/DSEG7Classic-Bold.woff2") format("woff2");
        font-weight: 700;
        font-display: swap;
    }

    /* GitHub のダークテーマに合わせた色 */
    :root {
        --bg: #0d1117;
        --bg-inset: #010409;
        --bg-muted: #151b23;
        --border: #30363d;
        --fg: #e6edf3;
        --fg-muted: #9198a1;
        --accent: #4493f8;
        --success: #3fb950;
        --attention: #d29922;
        --font-mono: "M PLUS 1 Code", ui-monospace, monospace;
        --font-7seg: "DSEG7 Classic", monospace;
        color-scheme: dark;
    }

    *,
    *::before,
    *::after {
        box-sizing: border-box;
    }

    html {
        scrollbar-gutter: stable;
    }

    body {
        margin: 0;
        background-color: var(--bg);
        color: var(--fg);
        font-family: "Zen Kaku Gothic New", sans-serif;
        font-size: 15px;
        line-height: 1.6;
    }

    a {
        color: var(--accent);
        text-decoration: none;
    }

    a:hover {
        text-decoration: underline;
    }

    /* 枠線で囲んだ箱 (GitHub の README やリポジトリのカード) */
    .box {
        background-color: var(--bg);
        border: 1px solid var(--border);
        border-radius: 6px;
    }

    .box-header {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 8px 16px;
        background-color: var(--bg-muted);
        border-bottom: 1px solid var(--border);
        border-radius: 6px 6px 0 0;
        font-family: var(--font-mono);
        font-size: 13px;
        color: var(--fg-muted);
    }

    .box-body {
        padding: 24px 32px;
    }

    .section-title {
        display: flex;
        align-items: center;
        gap: 8px;
        margin: 0 0 8px;
        font-size: 16px;
        font-weight: 400;
    }

    .section-title .icon {
        color: var(--fg-muted);
    }

    /* 「Public」などの小さなラベル */
    .label {
        padding: 0 7px;
        border: 1px solid var(--border);
        border-radius: 2em;
        font-size: 12px;
        line-height: 18px;
        color: var(--fg-muted);
        white-space: nowrap;
    }

    /* 言語の色の丸 */
    .dot {
        display: inline-block;
        width: 12px;
        height: 12px;
        border-radius: 50%;
        background-color: var(--c);
    }

    @media (max-width: 767px) {
        .box-body {
            padding: 16px;
        }
    }
</style>

<style>
    .site-header {
        background-color: var(--bg-inset);
        border-bottom: 1px solid var(--border);
    }

    .topbar {
        padding: 16px 32px 8px;
    }

    .brand {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        color: var(--fg);
        font-size: 15px;
        font-weight: 700;
    }

    .brand img {
        border-radius: 50%;
        border: 1px solid var(--border);
        object-fit: cover;
    }

    .tabs {
        display: flex;
        gap: 8px;
        padding: 0 24px;
        overflow-x: auto;
    }

    .tabs a {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 8px 8px 10px;
        border-bottom: 2px solid transparent;
        color: var(--fg);
        font-size: 14px;
        white-space: nowrap;
    }

    .tabs a:hover {
        border-bottom-color: var(--border);
        text-decoration: none;
    }

    .tabs a[aria-current="page"] {
        border-bottom-color: #f78166;
        font-weight: 700;
    }

    .tabs :global(.icon) {
        color: var(--fg-muted);
    }

    .container {
        display: grid;
        grid-template-columns: 296px minmax(0, 1fr);
        gap: 32px;
        align-items: start;
        max-width: 1280px;
        margin: 0 auto;
        padding: 24px 32px 48px;
    }

    main {
        display: flex;
        flex-direction: column;
        gap: 24px;
        min-width: 0;
    }

    footer {
        display: flex;
        align-items: center;
        gap: 8px;
        max-width: 1280px;
        margin: 0 auto;
        padding: 24px 32px 40px;
        border-top: 1px solid var(--border);
        font-size: 12px;
        color: var(--fg-muted);
    }

    @media (max-width: 1011px) {
        .container {
            grid-template-columns: 220px minmax(0, 1fr);
            gap: 24px;
        }
    }

    @media (max-width: 767px) {
        .topbar {
            padding: 12px 16px 4px;
        }

        .tabs {
            padding: 0 8px;
        }

        .container {
            grid-template-columns: minmax(0, 1fr);
            padding: 16px 16px 32px;
        }

        footer {
            padding: 24px 16px 32px;
        }
    }
</style>
