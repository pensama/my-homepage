---
const { title } = Astro.props;
---

<html lang="ja">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width" />
        <title>{title}</title>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Zen+Kaku+Gothic+New:wght@400;700&display=swap"
            rel="stylesheet"
        />
    </head>
    <body>
        <header>
            <nav>
                <a href="/">Home</a>
                <a href="/about">About</a>
                <a href="/works">Works</a>
            </nav>
        </header>

        <main>
            <slot />
        </main>

        <footer>© 2026 pensama</footer>
    </body>
</html>

<style>
    html {
    scrollbar-gutter: stable;
}
    body {
        max-width: 720px;
        margin: 0 auto;
        padding: 2rem 1.5rem;
        font-family: "Zen Kaku Gothic New", sans-serif;
        line-height: 1.8;
        color: #ffffff;
        background-color: #0F172A;
    }

    nav {
        display: inline-flex;
        gap: 1.5rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid #222630;
    }

    nav a {
        color: #4a90d9;
        text-decoration: none;
        transition: color 0.2s ease;
    }

    nav a:hover {
        color: #2f6bb3;
    }

    main {
        margin-top: 1.5rem;
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    footer {
        margin-top: 2rem;
        padding-top: 1rem;
        font-size: 0.85rem;
        color: #888;
    }
    
</style>