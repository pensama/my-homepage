---
// 扱える・勉強中のプログラミング言語を、GitHub の言語表示のように色の丸付きで並べる
// 色は GitHub Linguist の languages.yml (MIT License, Copyright (c) 2017 GitHub, Inc.) の値。拡張子は代表的なもの
const known: Record<string, { color: string; ext: string }> = {
    'assembly': { color: '#6e4c13', ext: '.asm' },
    'astro': { color: '#ff5a03', ext: '.astro' },
    'c': { color: '#555555', ext: '.c' },
    'c#': { color: '#7355dd', ext: '.cs' },
    'c++': { color: '#f34b7d', ext: '.cpp' },
    'clojure': { color: '#db5855', ext: '.clj' },
    'common lisp': { color: '#3fb68b', ext: '.lisp' },
    'crystal': { color: '#000100', ext: '.cr' },
    'css': { color: '#663399', ext: '.css' },
    'cuda': { color: '#3a4e3a', ext: '.cu' },
    'dart': { color: '#00b4ab', ext: '.dart' },
    'elixir': { color: '#6e4a7e', ext: '.ex' },
    'elm': { color: '#60b5cc', ext: '.elm' },
    'erlang': { color: '#b83998', ext: '.erl' },
    'f#': { color: '#b845fc', ext: '.fs' },
    'fortran': { color: '#4d41b1', ext: '.f' },
    'gdscript': { color: '#355570', ext: '.gd' },
    'gleam': { color: '#ffaff3', ext: '.gleam' },
    'glsl': { color: '#5686a5', ext: '.glsl' },
    'go': { color: '#00add8', ext: '.go' },
    'haskell': { color: '#5e5086', ext: '.hs' },
    'hlsl': { color: '#aace60', ext: '.hlsl' },
    'html': { color: '#e34c26', ext: '.html' },
    'java': { color: '#b07219', ext: '.java' },
    'javascript': { color: '#f1e05a', ext: '.js' },
    'julia': { color: '#a270ba', ext: '.jl' },
    'kotlin': { color: '#a97bff', ext: '.kt' },
    'lua': { color: '#000080', ext: '.lua' },
    'matlab': { color: '#e16737', ext: '.m' },
    'mojo': { color: '#ff4c1f', ext: '.mojo' },
    'nim': { color: '#ffc200', ext: '.nim' },
    'objective-c': { color: '#438eff', ext: '.m' },
    'ocaml': { color: '#ef7a08', ext: '.ml' },
    'pascal': { color: '#e3f171', ext: '.pas' },
    'perl': { color: '#0298c3', ext: '.pl' },
    'php': { color: '#4f5d95', ext: '.php' },
    'powershell': { color: '#012456', ext: '.ps1' },
    'processing': { color: '#0096d8', ext: '.pde' },
    'prolog': { color: '#74283c', ext: '.pl' },
    'python': { color: '#3572a5', ext: '.py' },
    'r': { color: '#198ce7', ext: '.r' },
    'racket': { color: '#3c5caa', ext: '.rkt' },
    'ruby': { color: '#701516', ext: '.rb' },
    'rust': { color: '#dea584', ext: '.rs' },
    'scala': { color: '#c22d40', ext: '.scala' },
    'scheme': { color: '#1e4aec', ext: '.scm' },
    'shell': { color: '#89e051', ext: '.sh' },
    'solidity': { color: '#aa6746', ext: '.sol' },
    'sql': { color: '#e38c00', ext: '.sql' },
    'svelte': { color: '#ff3e00', ext: '.svelte' },
    'swift': { color: '#f05138', ext: '.swift' },
    'typescript': { color: '#3178c6', ext: '.ts' },
    'verilog': { color: '#b2b7f8', ext: '.v' },
    'vhdl': { color: '#adb2cb', ext: '.vhdl' },
    'visual basic .net': { color: '#945db7', ext: '.vb' },
    'vue': { color: '#41b883', ext: '.vue' },
    'zig': { color: '#ec915c', ext: '.zig' },
};

interface Props {
    // status は '扱える' か '勉強中'。color と ext は、上の一覧にない言語のときだけ書けばよい
    languages: { name: string; status: string; color?: string; ext?: string }[];
}

const { languages } = Astro.props;

// 扱える → 勉強中 の順に並べる (ほかの status を書いたときは、その後ろに見出しを作って並べる)
const order = ['扱える', '勉強中'];
const rank = (status: string) => (order.includes(status) ? order.indexOf(status) : order.length);
const groups = [...new Set(languages.map((lang) => lang.status))]
    .sort((a, b) => rank(a) - rank(b))
    .map((status) => ({ status, items: languages.filter((lang) => lang.status === status) }));
---

<div class="box languages">
    {groups.map((group) => (
        <div class="group" data-status={group.status}>
            <h3 class="group-label">
                {group.status}
                <span class="count">{group.items.length}</span>
            </h3>
            <ul class="chips">
                {group.items.map((lang) => {
                    const info = known[lang.name.toLowerCase()];
                    const ext = lang.ext ?? info?.ext;
                    return (
                        <li class="chip">
                            <span class="dot" style={`--c: ${lang.color ?? info?.color ?? '#8b949e'}`}></span>
                            {lang.name}
                            {ext && <span class="ext" aria-hidden="true">{ext}</span>}
                        </li>
                    );
                })}
            </ul>
        </div>
    ))}
</div>

<style>
    .group {
        display: flex;
        align-items: flex-start;
        gap: 8px 16px;
        padding: 12px 16px;
    }

    .group + .group {
        border-top: 1px solid var(--border);
    }

    .group-label {
        flex-shrink: 0;
        display: flex;
        align-items: center;
        gap: 6px;
        width: 6.5em;
        margin: 4px 0 0;
        font-size: 13px;
        color: var(--fg-muted);
    }

    .group[data-status="扱える"] .group-label {
        color: var(--success);
    }

    .group[data-status="勉強中"] .group-label {
        color: var(--attention);
    }

    /* GitHub の件数表示 (Counter) 風 */
    .count {
        padding: 0 6px;
        border-radius: 2em;
        background-color: rgba(101, 108, 118, 0.3);
        font-size: 12px;
        font-weight: 400;
        line-height: 18px;
        color: var(--fg);
    }

    .chips {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

    .chip {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 3px 12px;
        border: 1px solid var(--border);
        border-radius: 2em;
        background-color: var(--bg-muted);
        font-size: 14px;
        line-height: 20px;
    }

    /* 暗い色 (Lua の紺など) でも丸が背景に埋もれないように縁を付ける */
    .chip .dot {
        box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.15);
    }

    .ext {
        font-family: var(--font-mono);
        font-size: 12px;
        color: var(--fg-muted);
    }

    @media (max-width: 767px) {
        .group {
            flex-direction: column;
        }

        .group-label {
            width: auto;
            margin: 0;
        }
    }
</style>
